# Linux and macOS each get their own settings below (common:linux, …).
common --enable_platform_specific_config

# Actions don't see the shell's PATH and variables: builds don't depend on
# who runs them. (API keys in the environment never reach tests either.)
build --incompatible_strict_action_env
test --test_output=errors

# Blitz builds nothing for Android, but protobuf's module depends on
# rules_jvm_external and rules_kotlin, which bring rules_android and its
# SDK toolchain. rules_android sets that up from ANDROID_HOME, and fails
# the whole build when the variable names a missing or partial SDK. Empty,
# it makes a stand-in, whatever the machine has installed.
common --repo_env=ANDROID_HOME=

# The protos' comments reach the generated Go code (its doc comments):
# descriptor sets keep their source info.
common --experimental_proto_descriptor_sets_include_source_info

# The desktop app supports macOS 13 and later.
build --macos_minimum_os=13.0
build --host_macos_minimum_os=13.0

# Wails on Linux: WebKitGTK 4.1 (Ubuntu 24.04, Debian 13 and later).
common:linux --@rules_go//go/config:tags=webkit2_41

# The gVisor tests find runsc through this; CI sets it, and they skip
# without it.
test --test_env=RUNSC_PATH

# Settings loaded in tests default to sandbox.shell = "required" on Linux
# (config.DefaultShellMode), which a machine without the OS sandbox can't
# meet: tests run in "auto", sandboxed wherever it works (CI makes sure it
# does). Tests of the default clear it.
test --test_env=BLITZ_SANDBOX_SHELL=auto

# Aspect's rulesets report usage unless told not to.
common --repo_env=ASPECT_TOOLS_TELEMETRY=off

# The Go tests with the race detector (CI runs them this way). Only tests:
# the release binaries are pure Go, which -race can't build.
test:race --@rules_go//go/config:race
test:race --build_tests_only

# Output directories are named after the target platform, not the host's
# CPU: generated Go files' paths end up in the binaries, and the release
# binaries must come out byte for byte the same on every machine.
common --experimental_platform_in_output_dir

# Releases are stamped with the version from git (build/workspace_status.sh);
# other builds aren't, so they stay cacheable.
common --workspace_status_command=build/workspace_status.sh
common:release --stamp

# Personal settings (a disk cache, say) go in user.bazelrc, not committed.
try-import %workspace%/user.bazelrc
