load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_hugo//hugo:rules.bzl", "hugo_serve", "hugo_site", "hugo_theme")

# The project's documentation, published to GitHub Pages from main:
#   bazel build //docs:site     (the site, in bazel-bin/docs/site)
#   bazel run //docs:serve      (a local preview at http://localhost:1313)

hugo_theme(
    name = "geekdoc",
    srcs = ["@geekdoc//:files"],
    theme_name = "hugo-geekdoc",
)

# The site serves Geekdoc's styles, scripts and fonts, so it carries the
# theme's license (MIT), linked from the About page.
copy_file(
    name = "geekdoc_license",
    src = "@geekdoc//:LICENSE",
    out = "static/licenses/hugo-geekdoc.txt",
)

# The API reference: a page per proto in proto/blitz/v1, with its
# messages, enums and services as Mermaid class diagrams.
genrule(
    name = "api",
    srcs = ["//proto/blitz/v1:srcs"],
    outs = ["content/architecture/api/%s.md" % p for p in [
        "config",
        "file",
        "language",
        "session",
        "turn",
        "worker",
        "workspace",
    ]],
    cmd = "$(location api_pages.sh) $(execpath @com_github_googlecloudplatform_proto_gen_md_diagrams//:proto-gen-md-diagrams) $(RULEDIR)/content/architecture/api $(SRCS)",
    tools = [
        "api_pages.sh",
        "@com_github_googlecloudplatform_proto_gen_md_diagrams//:proto-gen-md-diagrams",
    ],
)

# CONTRIBUTING.md stays in docs/, where GitHub finds it, and appears on the
# site under Development: front matter added, its title dropped (the site
# shows it), its links to content/… made relative to the page, and "Edit
# page" pointed at the file itself.
genrule(
    name = "contributing",
    srcs = ["CONTRIBUTING.md"],
    outs = ["content/development/contributing.md"],
    cmd = """{
  printf -- '---\\ntitle: Contributing\\nweight: 5\\ngeekdocFilePath: CONTRIBUTING.md\\n---\\n\\n'
  sed -e '1{/^# /d;}' -e 's#](content/#](../#g' $<
} > $@""",
)

hugo_site(
    name = "site",
    config = "hugo.yaml",
    content = glob(["content/**"]) + [
        ":api",
        ":contributing",
    ],
    # data/coverage.json, when tools/coverage.sh (or CI) has written it, is
    # the coverage page's report. rules_hugo copies a theme's layouts,
    # assets and static files, not its data; Geekdoc finds its
    # fingerprinted assets through its assets.json.
    data = glob(
        ["data/**"],
        allow_empty = True,
    ) + ["@geekdoc//:data/assets.json"],
    layouts = glob(["layouts/**"]),
    # Hugo's errors (a broken link, say) are only printed when not quiet.
    quiet = False,
    static = glob(["static/**"]) + [":geekdoc_license"],
    theme = ":geekdoc",
)

hugo_serve(
    name = "serve",
    dep = [":site"],
    visibility = ["//:__pkg__"],
)
