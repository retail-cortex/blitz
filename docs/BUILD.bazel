load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_hugo//hugo:rules.bzl", "hugo_serve", "hugo_site", "hugo_theme")

# The project's documentation, published to GitHub Pages from main:
#   bazel build //docs:site     (the site, in bazel-bin/docs/site)
#   bazel run //docs:serve      (a local preview at http://localhost:1313)

hugo_theme(
    name = "geekdoc",
    srcs = ["@geekdoc//:files"],
    theme_name = "hugo-geekdoc",
)

# The site serves Geekdoc's styles, scripts and fonts, so it carries the
# theme's license (MIT), linked from the About page.
copy_file(
    name = "geekdoc_license",
    src = "@geekdoc//:LICENSE",
    out = "static/licenses/hugo-geekdoc.txt",
)

hugo_site(
    name = "site",
    config = "hugo.yaml",
    content = glob(["content/**"]),
    # rules_hugo copies a theme's layouts, assets and static files, not its
    # data; Geekdoc finds its fingerprinted assets through this file.
    data = ["@geekdoc//:data/assets.json"],
    layouts = glob(["layouts/**"]),
    # Hugo's errors (a broken link, say) are only printed when not quiet.
    quiet = False,
    static = glob(["static/**"]) + [":geekdoc_license"],
    theme = ":geekdoc",
)

hugo_serve(
    name = "serve",
    dep = [":site"],
)
