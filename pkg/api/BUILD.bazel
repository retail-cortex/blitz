load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "backend.go",
        "changes.go",
        "context.go",
        "doc.go",
        "extensions.go",
        "models.go",
        "permissions.go",
        "sessions.go",
        "tasks.go",
        "turn.go",
        "workers.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/api",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "//pkg/images",
    ],
)

go_test(
    name = "api_test",
    size = "small",
    srcs = ["api_test.go"],
    embed = [":api"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
