load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "service",
    srcs = [
        "network.go",
        "service.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/service",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/workers",
        "//pkg/observability",
        "//pkg/service/server",
        "//pkg/shellpath",
        "//pkg/socket",
    ],
)

go_test(
    name = "service_test",
    size = "small",
    srcs = [
        "network_test.go",
        "service_test.go",
    ],
    embed = [":service"],
    deps = [
        "//pkg/config",
        "//pkg/socket",
        "//proto/blitz/v1:blitzv1_go_proto",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
