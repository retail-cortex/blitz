load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "catalog",
    srcs = [
        "catalog.go",
        "place.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/catalog",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "//pkg/engine/agents",
        "//pkg/engine/commands",
        "//pkg/engine/gates",
        "//pkg/engine/skills",
        "//pkg/redact",
        "@com_github_burntsushi_toml//:toml",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "catalog_test",
    srcs = [
        "catalog_test.go",
        "place_test.go",
    ],
    embed = [":catalog"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
