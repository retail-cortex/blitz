load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pagehost",
    srcs = [
        "cli.go",
        "cli_other.go",
        "cli_windows.go",
        "cli_winpath.go",
        "host.go",
        "prefs.go",
        "sandbox.go",
        "update.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/pagehost",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fileview",
        "//pkg/legal",
        "//pkg/loginitem",
        "//pkg/pageserver",
        "//pkg/sandboxsetup",
        "//pkg/selfupdate",
        "//pkg/shellpath",
        "//pkg/socket",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
            "@org_golang_x_sys//windows/registry",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "pagehost_test",
    srcs = [
        "cli_install_test.go",
        "cli_test.go",
        "cli_winpath_test.go",
        "host_test.go",
        "prefs_test.go",
        "update_test.go",
    ],
    embed = [":pagehost"],
    deps = [
        "//pkg/legal",
        "//pkg/loginitem",
        "//pkg/pageserver",
        "//pkg/selfupdate",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
