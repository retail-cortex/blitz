load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "agentpkg",
    srcs = [
        "dep.go",
        "digest.go",
        "files.go",
        "lock.go",
        "uri.go",
        "version.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/agentpkg",
    visibility = ["//visibility:public"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "agentpkg_test",
    size = "small",
    srcs = [
        "uri_test.go",
        "version_test.go",
    ],
    embed = [":agentpkg"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
