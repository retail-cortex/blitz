load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "socket",
    srcs = ["socket.go"],
    importpath = "github.com/retail-cortex/blitz/pkg/socket",
    visibility = ["//visibility:public"],
    deps = ["//pkg/config"],
)

go_test(
    name = "socket_test",
    srcs = ["socket_test.go"],
    embed = [":socket"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
