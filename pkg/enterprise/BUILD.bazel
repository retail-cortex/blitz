load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "enterprise",
    srcs = [
        "branding.go",
        "catalog.go",
        "enterprise.go",
        "jobs.go",
        "models.go",
        "reach.go",
        "reviews.go",
        "run.go",
        "signin.go",
        "usage.go",
        "workspaces.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/enterprise",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "//pkg/i18n",
        "//pkg/secrets",
        "//pkg/signedin",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "enterprise_test",
    size = "small",
    srcs = [
        "enterprise_test.go",
        "files_test.go",
        "jobs_test.go",
        "reach_test.go",
    ],
    embed = [":enterprise"],
    deps = [
        "//pkg/config",
        "//pkg/enterprise/enterprisetest",
        "//pkg/i18n",
        "//pkg/secrets",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
