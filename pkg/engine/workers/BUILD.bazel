load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workers",
    srcs = [
        "permission.go",
        "policy.go",
        "runs.go",
        "schedule.go",
        "state.go",
        "worker.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/workers",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/desktop:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
    ],
    deps = [
        "//pkg/api",
        "//pkg/config",
        "@com_github_robfig_cron_v3//:cron",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "workers_test",
    srcs = [
        "leak_test.go",
        "state_test.go",
        "workers_test.go",
    ],
    embed = [":workers"],
    deps = [
        "//pkg/api",
        "//pkg/config",
        "@org_uber_go_goleak//:goleak",
    ],
)
