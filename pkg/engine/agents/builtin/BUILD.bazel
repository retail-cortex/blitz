load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "builtin",
    srcs = ["embed.go"],
    embedsrcs = [
        "agent-creator.md",
        "blitz.md",
        "helios.md",
        "model-judge.md",
        "planning-agent.md",
        "qa.md",
        "web-retriever.md",
        "project-setup.md",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/agents/builtin",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
        "//pkg/pageserver:__pkg__",
    ],
)
