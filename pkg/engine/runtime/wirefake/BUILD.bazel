load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wirefake",
    testonly = True,
    srcs = [
        "anthropic.go",
        "gemini.go",
        "openai.go",
        "wirefake.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/runtime/wirefake",
    visibility = ["//pkg/engine:__subpackages__"],
)

go_test(
    name = "wirefake_test",
    srcs = ["wirefake_test.go"],
    embed = [":wirefake"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
