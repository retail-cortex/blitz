load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "browser",
    srcs = [
        "browser.go",
        "cdp.go",
        "proxy.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/browser",
    visibility = [
        # The engine's browser tool, and blitz doctor.
        "//apps/cli:__pkg__",
        "//pkg/engine:__subpackages__",
    ],
    deps = ["@com_github_gorilla_websocket//:websocket"],
)

go_test(
    name = "browser_test",
    srcs = [
        "browser_test.go",
        "fake_test.go",
    ],
    embed = [":browser"],
    deps = [
        "//pkg/engine/browser/browsertest",
        "@com_github_gorilla_websocket//:websocket",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
