load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "commands",
    srcs = ["commands.go"],
    embedsrcs = [
        "builtin/review.md",
        "builtin/security-review.md",
        "builtin/simplify.md",
        "builtin/verify.md",
        "builtin/grill-me.md",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/commands",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/desktop:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
    ],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "commands_test",
    size = "small",
    srcs = ["commands_test.go"],
    embed = [":commands"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
