load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "breaker",
    srcs = ["breaker.go"],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/breaker",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/desktop:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
    ],
)

go_test(
    name = "breaker_test",
    srcs = ["breaker_test.go"],
    embed = [":breaker"],
)
