load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lsp",
    srcs = [
        "client.go",
        "manager.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/lsp",
    visibility = ["//pkg/engine:__subpackages__"],
)

go_test(
    name = "lsp_test",
    size = "small",
    srcs = [
        "lsp_test.go",
        "manager_test.go",
        "server_test.go",
    ],
    embed = [":lsp"],
    deps = [
        "//pkg/engine/lsp/lsptest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
