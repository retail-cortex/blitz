load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "builtin",
    srcs = ["embed.go"],
    embedsrcs = [
        "code-review/SKILL.md",
        "git-workflow/SKILL.md",
        "testing-tdd/SKILL.md",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/skills/builtin",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
        "//pkg/pageserver:__pkg__",
    ],
)

# The package's Markdown, for the visual editor's round-trip test
# (//apps/desktop/web:test, spec_visual_editor_037 VE-90), in the output
# tree as the page's tests need it.
copy_to_bin(
    name = "markdown",
    srcs = glob(["**/*.md"]),
    visibility = ["//apps/desktop/web:__pkg__"],
)
