load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "search",
    srcs = [
        "enrich.go",
        "index.go",
        "query.go",
        "scan.go",
        "vectors.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/search",
    # Only the engine: front ends search through api.Backend
    # (//tools:check_deps checks libraries).
    visibility = ["//pkg/engine:__subpackages__"],
    deps = [
        "//pkg/engine/table",
        "@com_github_philippgille_chromem_go//:chromem-go",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "search_test",
    srcs = [
        "enrich_test.go",
        "faults_test.go",
        "search_test.go",
        "vectors_test.go",
    ],
    embed = [":search"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
