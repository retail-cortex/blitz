load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "specs",
    srcs = [
        "declaration.go",
        "evidence.go",
        "ledger.go",
        "progress.go",
        "specs.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/specs",
    visibility = ["//pkg/engine:__subpackages__"],
)

go_test(
    name = "specs_test",
    srcs = [
        "declaration_test.go",
        "ledger_test.go",
        "progress_test.go",
        "specs_test.go",
    ],
    embed = [":specs"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
