load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "memory",
    srcs = ["memory.go"],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/memory",
    visibility = [
        # The engine, the service, and the CLI's --local mode; the other
        # three only in tests (//tools:check_deps checks libraries).
        "//apps/cli:__pkg__",
        "//apps/cli/internal/tui:__pkg__",
        "//apps/desktop:__pkg__",
        "//apps/service:__subpackages__",
        "//pkg/client:__pkg__",
        "//pkg/engine:__subpackages__",
    ],
    deps = [
        "//pkg/config",
        "//pkg/textutil",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "memory_test",
    srcs = [
        "compat_test.go",
        "memory_test.go",
    ],
    embed = [":memory"],
    deps = ["//pkg/config"],
)
