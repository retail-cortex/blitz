load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "table",
    srcs = [
        "query.go",
        "table.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/engine/table",
    # Only the engine: the desktop app reads tables through
    # FileService.ReadTable (//tools:check_deps checks libraries).
    visibility = ["//pkg/engine:__subpackages__"],
    deps = ["@org_golang_x_text//encoding/charmap"],
)

go_test(
    name = "table_test",
    srcs = ["table_test.go"],
    embed = [":table"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_text//encoding/charmap",
    ],
)
