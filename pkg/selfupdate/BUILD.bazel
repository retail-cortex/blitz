load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "selfupdate",
    srcs = [
        "selfupdate.go",
        "verify.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/selfupdate",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_sigstore_sigstore_go//pkg/bundle",
        "@com_github_sigstore_sigstore_go//pkg/root",
        "@com_github_sigstore_sigstore_go//pkg/tuf",
        "@com_github_sigstore_sigstore_go//pkg/verify",
    ],
)

go_test(
    name = "selfupdate_test",
    srcs = [
        "selfupdate_test.go",
        "verify_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":selfupdate"],
    deps = [
        "@com_github_sigstore_sigstore_go//pkg/root",
        "@com_github_sigstore_sigstore_go//pkg/testing/ca",
        "@com_github_sigstore_sigstore_go//pkg/verify",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
