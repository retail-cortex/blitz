load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "textutil",
    srcs = [
        "glob.go",
        "html.go",
        "textutil.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/textutil",
    visibility = ["//visibility:public"],
    deps = ["@org_golang_x_net//html"],
)

go_test(
    name = "textutil_test",
    size = "small",
    srcs = [
        "glob_test.go",
        "html_test.go",
        "textutil_test.go",
    ],
    embed = [":textutil"],
    deps = ["@com_github_stretchr_testify//assert"],
)
