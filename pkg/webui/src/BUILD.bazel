# The package's sources, in a Bazel package of their own that loads
# nothing from npm, so a page in another Bazel module (the enterprise
# admin console) can take them and compile them as its own.

load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

copy_to_bin(
    name = "src",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "**/*.test.*",
        ],
    ),
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "tests",
    srcs = glob(["**/*.test.*"]),
    visibility = ["//pkg/webui:__pkg__"],
)
