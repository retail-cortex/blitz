# Blitz's controls, charts, drawer, themes and styles as a package
# (spec_053_enterprise EN-05): the desktop page imports it as
# @blitz/webui, and so does the enterprise admin console, from Blitz's
# Bazel module.

load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//pkg/webui:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//pkg/webui:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

_srcs = [
    "package.json",
    "tsconfig.json",
    "//pkg/webui/src",
]

# The package as pages link it (pnpm's workspace:*), its sources as they
# are: each page's Vite compiles them.
npm_package(
    name = "pkg",
    srcs = _srcs,
    package = "@blitz/webui",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        ":node_modules",
        "//pkg/webui/src",
        "//pkg/webui/src:tests",
    ],
)

tsc_bin.tsc_test(
    name = "typecheck",
    args = ["--noEmit"],
    chdir = package_name(),
    data = [
        "package.json",
        "tsconfig.json",
        ":node_modules",
        "//pkg/webui/src",
        "//pkg/webui/src:tests",
    ],
)
