load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "i18n",
    srcs = ["i18n.go"],
    embedsrcs = [
        "locales/en-US.json",
        "locales/es.json",
        "locales/fr-CA.json",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/i18n",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_x_text//language",
        "@org_golang_x_text//language/display",
    ],
)

go_test(
    name = "i18n_test",
    srcs = ["i18n_test.go"],
    embed = [":i18n"],
    deps = ["@org_golang_x_text//language"],
)

# The catalogs, which the desktop page reads too.
copy_to_bin(
    name = "locales",
    srcs = glob(["locales/*.json"]),
    visibility = ["//apps/desktop/web:__pkg__"],
)
