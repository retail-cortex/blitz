load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "secrets",
    srcs = ["secrets.go"],
    importpath = "github.com/retail-cortex/blitz/pkg/secrets",
    visibility = ["//visibility:public"],
    deps = ["@com_github_burntsushi_toml//:toml"],
)

go_test(
    name = "secrets_test",
    srcs = ["secrets_test.go"],
    embed = [":secrets"],
    # TestOSStore (opt-in) writes to the keychain, which Bazel's macOS
    # sandbox blocks.
    tags = ["no-sandbox"],
)
