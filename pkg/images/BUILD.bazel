load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "images",
    srcs = [
        "clipboard.go",
        "images.go",
        "mentions.go",
        "store.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/images",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/pdftext",
        "@org_golang_google_genai//:genai",
        "@org_golang_x_image//draw",
        "@org_golang_x_image//webp",
    ],
)

go_test(
    name = "images_test",
    size = "small",
    srcs = [
        "clipboard_test.go",
        "documents_test.go",
        "images_test.go",
    ],
    embed = [":images"],
    shard_count = 3,
    deps = [
        "//pkg/pdftext",
        "@com_github_go_pdf_fpdf//:fpdf",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_genai//:genai",
    ],
)
