load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wininstall",
    srcs = [
        "registry_other.go",
        "registry_windows.go",
        "wininstall.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/wininstall",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows/registry",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "wininstall_test",
    size = "small",
    srcs = ["wininstall_test.go"],
    embed = [":wininstall"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
