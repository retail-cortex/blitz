load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plugins",
    srcs = [
        "apply.go",
        "importer.go",
        "marketplace.go",
        "plugins.go",
        "store.go",
    ],
    importpath = "github.com/retail-cortex/blitz/pkg/plugins",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "@com_github_burntsushi_toml//:toml",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "plugins_test",
    srcs = [
        "importer_test.go",
        "plugins_test.go",
        "store_test.go",
    ],
    embed = [":plugins"],
    deps = [
        "//pkg/config",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
