load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/retail-cortex/blitz
# Protos have hand-written rules (proto/blitz/v1): the Connect code is
# generated into the messages' package.
# gazelle:proto disable
# gazelle:resolve go github.com/retail-cortex/blitz/proto/blitz/v1 //proto/blitz/v1:blitzv1_go_proto
# Not Go, or not this module.
# gazelle:exclude apps/desktop/web
# gazelle:exclude apps/desktop/packaging

# `bazel run //:gazelle` writes the Go rules; run it after adding a package
# or an import.
gazelle(name = "gazelle")

# In every release archive.
exports_files(
    [
        "LICENSE",
        "NOTICE",
        "README.md",
        "THIRD_PARTY_NOTICES",
        "buf.yaml",
    ],
    visibility = [
        "//apps/desktop/packaging:__pkg__",
        "//pkg/legal:__pkg__",
        "//proto/blitz/v1:__pkg__",
        "//release:__pkg__",
    ],
)

# ---- Short names for what developers build and run, so nobody has to
# look for them (README.md, "Build, test and run"):
#
#   bazel run //:blitz -- doctor         the CLI (arguments after --)
#   bazel run //:blitzd                  the service, in the foreground
#   bazel run //:desktop                 the desktop app, with its own blitzd
#   bazel run //:desktop-web             the desktop page in a browser (?fake)
#   bazel run //:docs                    the docs site, http://localhost:1313
#   bazel build //:deb                   the desktop .deb (Linux)
#   bazel build //:mac-app               Blitz.app (macOS)
#   bazel build //:archives              every platform's release archive
#   bazel build //:build-all             everything this machine can build:
#                                        //:build-all-linux or -mac

alias(
    name = "blitz",
    actual = "//apps/cli:blitz",
)

alias(
    name = "blitzd",
    actual = "//apps/service:blitzd",
)

alias(
    name = "tray",
    actual = "//apps/tray:blitz-tray",
)

alias(
    name = "desktop",
    actual = "//apps/desktop:blitz-desktop",
)

alias(
    name = "desktop-web",
    actual = "//apps/desktop/web:dev",
)

alias(
    name = "docs",
    actual = "//docs:serve",
)

alias(
    name = "deb",
    actual = "//apps/desktop/packaging:deb",
)

alias(
    name = "mac-app",
    actual = "//apps/desktop/packaging:Blitz.app",
)

alias(
    name = "archives",
    actual = "//release:archives",
)

# The programs and the desktop package for this machine. Manual: //...
# already builds each of them, and one OS's set fails on the other.
filegroup(
    name = "build-all-linux",
    srcs = [
        ":blitz",
        ":blitzd",
        ":deb",
        ":desktop",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "build-all-mac",
    srcs = [
        ":blitz",
        ":blitzd",
        ":desktop",
        ":mac-app",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

alias(
    name = "build-all",
    actual = select({
        "@platforms//os:linux": ":build-all-linux",
        "@platforms//os:macos": ":build-all-mac",
    }),
    tags = ["manual"],
)
