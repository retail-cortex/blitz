# A developer's own environment (direnv) and editor swap files.
.envrc
*.swp
*.swo

# Bazel's links to its outputs, and a developer's own Bazel settings.
/bazel-*
/user.bazelrc

# node_modules that pnpm makes when run on the page directly; Bazel keeps
# its own (and .bazelignore hides this one from it).
node_modules/
