load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@webkitgtk//:defs.bzl", "COPTS", "LINKOPTS")

go_library(
    name = "webprocess",
    srcs = [
        "webprocess.go",
        "webprocess.h",
        "webprocess_linux.c",
        "webprocess_linux.go",
        "webprocess_other.go",
    ],
    cgo = True,
    # GTK and WebKitGTK's flags from pkg-config (//build:pkg_config.bzl):
    # rules_go doesn't read #cgo pkg-config lines.
    clinkopts = select({
        "@rules_go//go/platform:linux": LINKOPTS,
        "//conditions:default": [],
    }),  # keep
    copts = select({
        "@rules_go//go/platform:linux": COPTS,
        "//conditions:default": [],
    }),  # keep
    importpath = "github.com/retail-cortex/blitz/apps/desktop/internal/webprocess",
    visibility = ["//apps/desktop:__subpackages__"],
)

go_test(
    name = "webprocess_test",
    size = "small",
    srcs = ["webprocess_test.go"],
    embed = [":webprocess"],
    # A web view needs a display: CI runs this under xvfb-run, as it does
    # printpdf's tests; without one, the test skips.
    env_inherit = [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XAUTHORITY",
        "XDG_RUNTIME_DIR",
    ],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
