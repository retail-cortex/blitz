load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@webkitgtk//:defs.bzl", "COPTS", "LINKOPTS")

go_library(
    name = "printpdf",
    srcs = [
        "callback.go",
        "print.h",
        "print_darwin.go",
        "print_darwin.m",
        "print_linux.c",
        "print_linux.go",
        "print_other.go",
        "printpdf.go",
    ],
    cgo = True,
    # GTK and WebKitGTK's flags from pkg-config (//build:pkg_config.bzl):
    # rules_go doesn't read #cgo pkg-config lines.
    clinkopts = select({
        "@rules_go//go/platform:darwin": [
            "-framework AppKit -framework WebKit",
        ],
        "@rules_go//go/platform:linux": LINKOPTS,
        "//conditions:default": [],
    }),  # keep
    copts = select({
        "@rules_go//go/platform:darwin": [
            "-x objective-c -fobjc-arc",
        ],
        "@rules_go//go/platform:linux": COPTS,
        "//conditions:default": [],
    }),  # keep
    importpath = "github.com/retail-cortex/blitz/apps/desktop/internal/printpdf",
    visibility = ["//apps/desktop:__subpackages__"],
)

go_test(
    name = "printpdf_test",
    size = "small",
    srcs = ["printpdf_test.go"],
    embed = [":printpdf"],
    # Linux prints only with a display: CI runs this under xvfb-run, with
    # the X socket mounted into the sandbox; without one, the printing
    # tests skip.
    env_inherit = [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XAUTHORITY",
        "XDG_RUNTIME_DIR",
    ],
    deps = [
        "//pkg/pdftext",
        "@com_github_ledongthuc_pdf//:pdf",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
