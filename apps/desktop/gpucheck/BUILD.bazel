# How the Linux app draws, with the graphics card or in software
# (DSK-100): a manual check on a machine with a display and a GPU,
#   bazel run //apps/desktop/gpucheck:gpu_check
# Manual, so //... neither builds nor tests it.

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@webkitgtk//:defs.bzl", "COPTS", "LINKOPTS")

# cgo, as //apps/desktop/internal/printpdf: cc rules refuse the system's
# include paths.
go_library(
    name = "gpucheck_lib",
    srcs = [
        "gpu_probe.c",
        "gpu_probe.go",
        "gpu_probe.h",
    ],
    cgo = True,
    clinkopts = LINKOPTS,  # keep
    copts = COPTS,  # keep
    importpath = "github.com/retail-cortex/blitz/apps/desktop/gpucheck",
    tags = ["manual"],  # keep
    target_compatible_with = ["@platforms//os:linux"],  # keep
    visibility = ["//visibility:private"],
)

# WebKit's own report (webkit://gpu) under the app's policy.
go_binary(
    name = "gpu_probe",
    embed = [":gpucheck_lib"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "gpu_check",
    srcs = ["gpu_check.sh"],
    data = [
        ":gpu_probe",
        "//apps/desktop:blitz-desktop_unsigned",
        "//apps/service:blitzd",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
