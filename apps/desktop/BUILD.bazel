load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:macos.bzl", "macho_uuid_linkopts", "signed_binary")

# The page is the same for every platform: it's built for this machine
# (its tools are native), even when the app is built for another.
platform_transition_filegroup(
    name = "page",
    srcs = ["//apps/desktop/web:page"],
    target_platform = "@platforms//host",
)

# The page, where go:embed looks for it.
copy_to_directory(
    name = "dist",
    srcs = [":page"],
    root_paths = ["apps/desktop/web/dist"],
)

# Info.plist embedded in the executable on macOS, so the app has a bundle
# identifier outside Blitz.app too (the open-panel service needs one).
cc_library(
    name = "embedded_info_plist",
    additional_linker_inputs = ["Info.plist"],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-sectcreate,__TEXT,__info_plist,$(location Info.plist)"],
        "//conditions:default": [],
    }),
)

go_library(
    name = "desktop_lib",
    srcs = [
        "app.go",
        "appearance.go",
        "appearance_darwin.go",
        "appearance_darwin.m",
        "appearance_other.go",
        "cli.go",
        "deeplink.go",
        "folder.go",
        "link_darwin.go",
        "main.go",
        "prefs.go",
        "sandbox.go",
        "unsaved.go",
    ],
    cdeps = [":embedded_info_plist"],  # keep
    cgo = True,
    clinkopts = select({
        "@rules_go//go/platform:darwin": [
            "-framework UniformTypeIdentifiers",
            "-framework AppKit",
        ],
        "@rules_go//go/platform:ios": [
            "-framework UniformTypeIdentifiers",
            "-framework AppKit",
        ],
        "//conditions:default": [],
    }),
    embedsrcs = [":dist"],  # keep
    importpath = "github.com/retail-cortex/blitz/apps/desktop",
    visibility = ["//visibility:private"],
    deps = [
        "//apps/desktop/internal/printpdf",
        "//pkg/config",
        "//pkg/fileview",
        "//pkg/legal",
        "//pkg/loginitem",
        "//pkg/pageserver",
        "//pkg/sandboxsetup",
        "//pkg/shellpath",
        "//pkg/socket",
        "@com_github_wailsapp_wails_v2//:wails",
        "@com_github_wailsapp_wails_v2//pkg/options",
        "@com_github_wailsapp_wails_v2//pkg/options/assetserver",
        "@com_github_wailsapp_wails_v2//pkg/options/mac",
        "@com_github_wailsapp_wails_v2//pkg/runtime",
    ],
)

go_binary(
    name = "blitz-desktop_unsigned",
    # The service it installs and restarts, the tray and the CLI it links
    # onto PATH, found in its runfiles under bazel run (Blitz.app and the
    # .deb put them beside the app instead).
    data = [
        "//apps/cli:blitz",
        "//apps/service:blitzd",
        "//apps/tray:blitz-tray",
    ],
    embed = [":desktop_lib"],
    # Its own Mach-O UUID (build/macos.bzl).
    gc_linkopts = macho_uuid_linkopts("dev.blitz.desktop"),
    # What `wails build` sets: the native window, not the dev server. A
    # binary's gotags replace --@rules_go//go/config:tags, so the
    # WebKitGTK 4.1 tag from .bazelrc goes here too: without it Wails
    # builds its legacy web view, which hands the page's API requests to
    # the proxy as GETs with no body. The tag only selects Linux files.
    gotags = [
        "desktop",
        "production",
        "webkit2_41",
    ],
    visibility = ["//visibility:public"],
    # The release version (--config=release), else the default in main.go.
    x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
)

go_test(
    name = "desktop_test",
    size = "small",
    srcs = [
        "app_test.go",
        "appearance_test.go",
        "cli_test.go",
        "deeplink_test.go",
        "folder_test.go",
        "license_test.go",
        "prefs_test.go",
        "sandbox_test.go",
        "service_test.go",
    ],
    # A real blitzd, which TestStopServiceByPID starts and stops.
    data = [
        "//apps/service:blitzd",
        "//apps/tray:blitz-tray",
    ],
    embed = [":desktop_lib"],
    deps = [
        "//pkg/loginitem",
        "//pkg/socket",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# The app for each Mac, for the universal Blitz.app (//apps/desktop/packaging).
[
    go_binary(
        name = "blitz-desktop_darwin_" + arch,
        embed = [":desktop_lib"],
        gc_linkopts = macho_uuid_linkopts("dev.blitz.desktop/darwin/" + arch),
        goarch = arch,
        goos = "darwin",
        gotags = [
            "desktop",
            "production",
        ],
        pure = "off",
        target_compatible_with = ["@platforms//os:macos"],
        visibility = ["//apps/desktop/packaging:__pkg__"],
        x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

# The app as `bazel run //apps/desktop:blitz-desktop` runs it: signed as
# dev.blitz.desktop on macOS (//build:macos.bzl), with blitzd in its
# runfiles.
signed_binary(
    name = "blitz-desktop",
    binary = ":blitz-desktop_unsigned",
    identifier = "dev.blitz.desktop",
    visibility = ["//visibility:public"],
)
