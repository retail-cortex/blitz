<!-- What software centres (GNOME Software, Ubuntu's App Center, KDE
     Discover) show for the package: without it the author is "Unknown". -->
<component type="desktop-application">
  <id>dev.blitz.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Blitz</name>
  <summary>A coding agent for your projects</summary>
  <developer id="dev.blitz">
    <name>Retail Cortex</name>
  </developer>
  <!-- The same, for AppStream before 1.0 (Ubuntu 22.04's). -->
  <developer_name>Retail Cortex</developer_name>
  <description>
    <p>
      A window onto the Blitz service: workspaces, chats with the agent,
      approvals, changes and workers. Includes the blitz command,
      blitz-tray (the service in the system tray) and blitzd, the
      service, which it installs and starts.
    </p>
  </description>
  <launchable type="desktop-id">blitz-desktop.desktop</launchable>
  <icon type="stock">blitz-desktop</icon>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://retail-cortex.github.io/blitz/</url>
  <url type="bugtracker">https://github.com/retail-cortex/blitz/issues</url>
  <url type="vcs-browser">https://github.com/retail-cortex/blitz</url>
  <content_rating type="oars-1.1"/>
</component>
