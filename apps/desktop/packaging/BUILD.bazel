load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "pkg_mklink", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:macos.bzl", "signed_app")

# The desktop app's packages. Build with --config=release for the
# version; signing, notarising and the disk image are the release
# workflow's (sign_macos.sh), since they need Apple's tools and keys.

_MACOS = ["@platforms//os:macos"]

_LINUX = ["@platforms//os:linux"]

# ---- macOS: Blitz.app, universal (arm64 + x86_64), with the CLI and the
# service beside the app's executable, where it looks for them.

genrule(
    name = "info_plist",
    srcs = [
        "darwin/Info.plist.in",
        "//build:version",
    ],
    outs = ["app/Contents/Info.plist"],
    cmd = "sed \"s/@VERSION@/$$(cat $(location //build:version))/g\" $(location darwin/Info.plist.in) > $@",
    target_compatible_with = _MACOS,
)

genrule(
    name = "icon",
    srcs = ["appicon.png"],
    outs = ["app/Contents/Resources/iconfile.icns"],
    cmd = """
set="$$(mktemp -d)/iconfile.iconset"
mkdir -p "$$set"
for s in 16 32 128 256 512; do
  sips -z $$s $$s $< --out "$$set/icon_$${s}x$${s}.png" >/dev/null
  sips -z $$((s * 2)) $$((s * 2)) $< --out "$$set/icon_$${s}x$${s}@2x.png" >/dev/null
done
iconutil -c icns -o $@ "$$set"
""",
    target_compatible_with = _MACOS,
)

[
    genrule(
        name = "universal_" + exe,
        srcs = [
            target + "_darwin_amd64",
            target + "_darwin_arm64",
        ],
        outs = ["app/Contents/MacOS/" + exe],
        cmd = "lipo -create -output $@ $(SRCS)",
        target_compatible_with = _MACOS,
    )
    for exe, target in [
        ("blitz-desktop", "//apps/desktop:blitz-desktop"),
        ("blitz", "//apps/cli:blitz"),
        ("blitzd", "//apps/service:blitzd"),
        ("blitz-tray", "//apps/tray:blitz-tray"),
    ]
]

# The license, the notice and the third-party notices, in the bundle's
# Resources.
[
    copy_file(
        name = "resource_" + f.lower(),
        src = "//:" + f,
        out = "app/Contents/Resources/" + f,
        target_compatible_with = _MACOS,
    )
    for f in [
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES",
    ]
]

copy_to_directory(
    name = "unsigned/Blitz.app",
    srcs = [
        ":icon",
        ":info_plist",
        ":resource_license",
        ":resource_notice",
        ":resource_third_party_notices",
        ":universal_blitz",
        ":universal_blitz-desktop",
        ":universal_blitzd",
        ":universal_blitz-tray",
    ],
    root_paths = ["apps/desktop/packaging/app"],
    target_compatible_with = _MACOS,
)

# Signed ad hoc, so macOS knows it as dev.blitz.desktop: an unsigned or
# "a.out" app has its folder dialog turned away. Releases sign it again
# with a Developer ID (sign_macos.sh).
signed_app(
    name = "Blitz.app",
    app = ":unsigned/Blitz.app",
    target_compatible_with = _MACOS,
    visibility = ["//visibility:public"],
)

# ---- Linux: a .deb for WebKitGTK 4.1 (Ubuntu 24.04, Debian 13 and
# later), for this machine's architecture: the app, the CLI and the
# service in /usr/lib/blitz-desktop (the app finds the CLI beside its
# resolved executable), a link on PATH, a launcher and an icon.

pkg_files(
    name = "deb_programs",
    srcs = [
        "//apps/cli:blitz",
        "//apps/desktop:blitz-desktop",
        "//apps/service:blitzd",
        "//apps/tray:blitz-tray",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/lib/blitz-desktop",
    target_compatible_with = _LINUX,
)

pkg_mklink(
    name = "deb_link",
    link_name = "usr/bin/blitz-desktop",
    target = "../lib/blitz-desktop/blitz-desktop",
)

pkg_files(
    name = "deb_launcher",
    srcs = ["linux/blitz-desktop.desktop"],
    prefix = "usr/share/applications",
)

pkg_files(
    name = "deb_icon",
    srcs = ["appicon.png"],
    prefix = "usr/share/icons/hicolor/1024x1024/apps",
    renames = {"appicon.png": "blitz-desktop.png"},
)

# The icon's source, which the desktop draws sharp at any size.
pkg_files(
    name = "deb_icon_scalable",
    srcs = ["appicon.svg"],
    prefix = "usr/share/icons/hicolor/scalable/apps",
    renames = {"appicon.svg": "blitz-desktop.svg"},
)

# Debian's copyright file (the Apache License is the system's copy, in
# /usr/share/common-licenses), with the notice and the third-party notices.
pkg_files(
    name = "deb_doc",
    srcs = [
        "linux/copyright",
        "//:NOTICE",
        "//:THIRD_PARTY_NOTICES",
    ],
    prefix = "usr/share/doc/blitz-desktop",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "deb_data",
    srcs = [
        ":deb_doc",
        ":deb_icon",
        ":deb_icon_scalable",
        ":deb_launcher",
        ":deb_link",
        ":deb_programs",
    ],
    extension = "tar.gz",
    target_compatible_with = _LINUX,
)

pkg_deb(
    name = "deb",
    architecture = select({
        "@platforms//cpu:arm64": "arm64",
        "@platforms//cpu:x86_64": "amd64",
    }),
    data = ":deb_data",
    # 2.40 is the first WebKitGTK that hands the app a request's body
    # (the webkit2_41 web view, apps/desktop/BUILD.bazel).
    depends = [
        "libgtk-3-0t64 | libgtk-3-0",
        "libwebkit2gtk-4.1-0 (>= 2.40)",
    ],
    description = """Blitz desktop app
A window onto the Blitz service: workspaces, chats with the agent,
approvals, changes and workers. Includes the blitz command, blitz-tray (the service in the system
tray) and blitzd,
the service, which it installs and starts.""",
    homepage = "https://github.com/retail-cortex/blitz",
    maintainer = "Blitz <https://github.com/retail-cortex/blitz/issues>",
    package = "blitz-desktop",
    # Debian's name_arch; rules_pkg's default, name_version_arch, would
    # leave the version out ("blitz-desktop__amd64.deb"): it comes from
    # version_file, at build time. The release workflow adds it.
    package_file_name = select({
        "@platforms//cpu:arm64": "blitz-desktop_arm64.deb",
        "@platforms//cpu:x86_64": "blitz-desktop_amd64.deb",
    }),
    priority = "optional",
    section = "devel",
    target_compatible_with = _LINUX,
    version_file = "//build:version",
    visibility = ["//visibility:public"],
)

# The packages carry the license files (each on its own platform).
sh_test(
    name = "app_contents_test",
    size = "small",
    srcs = ["contents_test.sh"],
    args = ["$(rootpath :Blitz.app)"],
    data = [":Blitz.app"],
    target_compatible_with = _MACOS,
)

sh_test(
    name = "deb_contents_test",
    size = "small",
    srcs = ["contents_test.sh"],
    args = ["$(rootpath :deb)"],
    data = [":deb"],
    target_compatible_with = _LINUX,
)
