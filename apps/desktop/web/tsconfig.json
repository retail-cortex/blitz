{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["vite/client", "node"],
    // src/gen is generated by Bazel (//apps/desktop/web:api_ts); editors
    // find it in the build's output after `bazel build //apps/desktop/web:api_ts`.
    "rootDirs": ["src", "../../../bazel-bin/apps/desktop/web/src"]
  },
  "include": ["src"]
}
