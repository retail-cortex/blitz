load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "winexe_lib",
    srcs = ["main.go"],
    importpath = "github.com/retail-cortex/blitz/apps/electron/winexe",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_tc_hib_winres//:winres",
        "@com_github_tc_hib_winres//version",
    ],
)

go_binary(
    name = "winexe",
    embed = [":winexe_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "winexe_test",
    size = "small",
    srcs = ["main_test.go"],
    args = [
        "-exe=$(rootpath @electron_win32_x64//:electron.exe)",
        "-icon=$(rootpath //apps/desktop/packaging:appicon.png)",
    ],
    data = [
        "//apps/desktop/packaging:appicon.png",
        "@electron_win32_x64//:electron.exe",
    ],
    embed = [":winexe_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_github_tc_hib_winres//:winres",
        "@com_github_tc_hib_winres//version",
    ],
)
