# Blitz's apt repository, installed with blitz-desktop, so that apt
# upgrade keeps the desktop app current. To stop it, set Enabled: no
# here: apt keeps your change when the package updates.
Types: deb
URIs: https://storage.googleapis.com/retail-cortex-blitz-apt
Suites: stable
Components: main
Signed-By: /usr/share/keyrings/blitz-desktop.asc
