# The install and post-refresh hooks (classic snaps' run as root): an
# AppArmor profile that lets the app's own program have user namespaces,
# which Chromium's sandbox needs and Ubuntu 24.04 and later give a program
# only through a profile. The .deb gives the sandbox chrome-sandbox setuid
# instead, which a snap can't carry. Elsewhere (no AppArmor 4) nothing is
# needed.
set -e
profile=/etc/apparmor.d/blitz-desktop-snap
[ -e /etc/apparmor.d/abi/4.0 ] && command -v apparmor_parser >/dev/null || exit 0
cat >"$profile.new" <<'PROFILE'
# Written by the blitz-desktop snap's hooks; removed with the snap.
abi <abi/4.0>,
include <tunables/global>

profile blitz-desktop-snap /snap/blitz-desktop/*/usr/lib/blitz-desktop/blitz-desktop flags=(unconfined) {
  userns,

  include if exists <local/blitz-desktop-snap>
}
PROFILE
mv "$profile.new" "$profile"
apparmor_parser -r "$profile"
