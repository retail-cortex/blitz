<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What blitzd and blitz need under the hardened runtime (sign_macos.sh):
     SQLite runs as WebAssembly compiled by wazero, which writes machine code
     and then makes it executable (mprotect, no MAP_JIT). Without this the
     kernel kills the process the first time a SQLite database is opened. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
