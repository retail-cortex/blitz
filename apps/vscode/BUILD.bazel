# The VS Code extension (spec_parity_027 PAR-INT-02): TypeScript compiled
# to CommonJS, with the desktop app's page in media/page, packed as a
# .vsix:
#   bazel build //apps/vscode:vsix   (then code --install-extension bazel-bin/apps/vscode/blitz.vsix)

load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//apps/vscode:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//apps/vscode:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

copy_to_bin(
    name = "srcs",
    srcs = glob(["src/**"]) + [
        "package.json",
        "tsconfig.build.json",
        "tsconfig.json",
    ],
)

_inputs = [
    ":srcs",
    ":node_modules",
]

# dist/*.js, the extension's code.
tsc_bin.tsc(
    name = "dist",
    srcs = _inputs,
    args = ["-p", "tsconfig.build.json"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

tsc_bin.tsc_test(
    name = "typecheck",
    size = "small",
    args = ["--noEmit"],
    chdir = package_name(),
    data = _inputs,
)

vitest_bin.vitest_test(
    name = "test",
    size = "small",
    args = ["run"],
    chdir = package_name(),
    data = _inputs,
)

# The .vsix VS Code installs. Releases stamp their version:
#   bazel build --action_env=VSIX_VERSION=1.2.3 //apps/vscode:vsix
genrule(
    name = "vsix",
    srcs = [
        "package.json",
        "README.md",
        "media/blitz.svg",
        ":dist",
        "//:LICENSE",
        "//apps/desktop/web:page",
    ],
    outs = ["blitz.vsix"],
    cmd = " ".join([
        "$(execpath //tools/vsix)",
        "--package $(execpath package.json)",
        "--out $@",
        "--version \"$${VSIX_VERSION:-}\"",
        "--add extension/dist=$(execpath :dist)",
        "--add extension/media/page=$(execpath //apps/desktop/web:page)",
        "--add extension/media/blitz.svg=$(execpath media/blitz.svg)",
        "--add extension/README.md=$(execpath README.md)",
        "--add extension/LICENSE.txt=$(execpath //:LICENSE)",
    ]),
    tools = ["//tools/vsix"],
)

# The package's Markdown, for the visual editor's round-trip test
# (//apps/desktop/web:test, spec_visual_editor_037 VE-90), in the output
# tree as the page's tests need it.
copy_to_bin(
    name = "markdown",
    srcs = glob(["*.md"]),
    visibility = ["//apps/desktop/web:__pkg__"],
)
