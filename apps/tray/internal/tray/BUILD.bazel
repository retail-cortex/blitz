load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tray",
    srcs = [
        "actions.go",
        "browser.go",
        "detach_unix.go",
        "detach_windows.go",
        "host.go",
        "ico.go",
        "locale.go",
        "tray.go",
    ],
    importpath = "github.com/retail-cortex/blitz/apps/tray/internal/tray",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//apps/tray:__subpackages__"],
    deps = [
        "//pkg/config",
        "//pkg/fileview",
        "//pkg/i18n",
        "//pkg/legal",
        "//pkg/loginitem",
        "//pkg/pageserver",
        "//pkg/socket",
        "//proto/blitz/v1:blitzv1_go_proto",
        "@com_connectrpc_connect//:connect",
        "@org_golang_x_text//language",
    ],
)

go_test(
    name = "tray_test",
    size = "small",
    srcs = [
        "actions_test.go",
        "browser_test.go",
        "host_test.go",
        "ico_test.go",
        "locale_test.go",
        "probe_test.go",
        "tray_test.go",
    ],
    embed = [":tray"],
    deps = [
        "//pkg/i18n",
        "//pkg/legal",
        "//pkg/loginitem",
        "//pkg/pageserver",
        "//pkg/socket",
        "//proto/blitz/v1:blitzv1_go_proto",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
