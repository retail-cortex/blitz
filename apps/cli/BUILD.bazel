load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:macos.bzl", "macho_uuid_linkopts", "signed_binary")

# The REPL's untranslated-output lint reads main.go too.
exports_files(["main.go"])

go_library(
    name = "cli_lib",
    srcs = [
        "configcmd.go",
        "configkeys.go",
        "configperms.go",
        "doctor.go",
        "exitcode.go",
        "license.go",
        "main.go",
        "oneshot.go",
        "service.go",
        "setup.go",
        "workers.go",
    ],
    importpath = "github.com/retail-cortex/blitz/apps/cli",
    visibility = ["//visibility:private"],
    deps = [
        "//apps/cli/internal/tui",
        "//pkg/api",
        "//pkg/client",
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/memory",
        "//pkg/engine/runtime",
        "//pkg/engine/skills",
        "//pkg/engine/tools",
        "//pkg/i18n",
        "//pkg/images",
        "//pkg/loginitem",
        "//pkg/observability",
        "//pkg/socket",
        "@com_github_burntsushi_toml//:toml",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
        "@org_golang_google_adk_v2//model",
        "@org_golang_google_adk_v2//session",
        "@org_golang_google_genai//:genai",
        "@org_golang_x_term//:term",
    ],
)

go_binary(
    name = "blitz_unsigned",
    embed = [":cli_lib"],
    # Its own Mach-O UUID (build/macos.bzl).
    gc_linkopts = macho_uuid_linkopts("dev.blitz.cli"),
    visibility = ["//visibility:public"],
    # The release version (--config=release), else the default in main.go.
    x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
)

go_test(
    name = "cli_test",
    srcs = [
        "attach_test.go",
        "configkeys_test.go",
        "images_test.go",
        "leak_test.go",
        "limits_test.go",
        "locale_test.go",
        "main_test.go",
        "service_test.go",
        "workers_test.go",
    ],
    embed = [":cli_lib"],
    # Starts commands in the OS sandbox, which can't nest in Bazel's on
    # macOS.
    tags = ["no-sandbox"],
    deps = [
        "//apps/service/servicetest",
        "//pkg/api",
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/runtime",
        "//pkg/i18n",
        "//pkg/loginitem",
        "//pkg/secrets",
        "//pkg/socket",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_genai//:genai",
        "@org_uber_go_goleak//:goleak",
    ],
)

# blitz for each released platform (//release), pure Go.
[
    go_binary(
        name = "blitz_" + goos + "_" + goarch,
        embed = [":cli_lib"],
        gc_linkopts = macho_uuid_linkopts("dev.blitz.cli/" + goos + "/" + goarch),
        goarch = goarch,
        goos = goos,
        pure = "on",
        visibility = [
            "//apps/desktop/packaging:__pkg__",
            "//release:__pkg__",
        ],
        x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
    )
    for goos, goarch in [
        ("darwin", "amd64"),
        ("darwin", "arm64"),
        ("linux", "amd64"),
        ("linux", "arm64"),
        ("windows", "amd64"),
    ]
]

# blitz signed as dev.blitz.cli on macOS (//build:macos.bzl): Bazel's links
# are all "a.out" to macOS otherwise.
signed_binary(
    name = "blitz",
    binary = ":blitz_unsigned",
    identifier = "dev.blitz.cli",
    visibility = ["//visibility:public"],
)
