load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:macos.bzl", "macho_uuid_linkopts", "signed_binary")

go_library(
    name = "service_lib",
    srcs = ["main.go"],
    importpath = "github.com/retail-cortex/blitz/apps/service",
    visibility = ["//visibility:private"],
    deps = [
        "//apps/service/internal/daemon",
        "//pkg/legal",
        "//pkg/pdftext",
        "//pkg/socket",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "blitzd_unsigned",
    embed = [":service_lib"],
    # Its own Mach-O UUID (build/macos.bzl).
    gc_linkopts = macho_uuid_linkopts("dev.blitz.service"),
    visibility = ["//visibility:public"],
    # The release version (--config=release), else the default in main.go.
    x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
)

go_test(
    name = "service_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":service_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# blitzd for each released platform (//release), pure Go.
[
    go_binary(
        name = "blitzd_" + goos + "_" + goarch,
        embed = [":service_lib"],
        gc_linkopts = macho_uuid_linkopts("dev.blitz.service/" + goos + "/" + goarch),
        goarch = goarch,
        goos = goos,
        pure = "on",
        visibility = [
            "//apps/desktop/packaging:__pkg__",
            "//release:__pkg__",
        ],
        x_defs = {"main.version": "{STABLE_BLITZ_VERSION}"},
    )
    for goos, goarch in [
        ("darwin", "amd64"),
        ("darwin", "arm64"),
        ("linux", "amd64"),
        ("linux", "arm64"),
        ("windows", "amd64"),
    ]
]

# blitzd signed as dev.blitz.service on macOS (//build:macos.bzl): Bazel's links
# are all "a.out" to macOS otherwise.
signed_binary(
    name = "blitzd",
    binary = ":blitzd_unsigned",
    identifier = "dev.blitz.service",
    visibility = ["//visibility:public"],
)
