load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "service_lib",
    srcs = ["main.go"],
    importpath = "github.com/retail-cortex/blitz/apps/service",
    visibility = ["//visibility:private"],
    deps = [
        "//apps/service/internal/daemon",
        "//pkg/socket",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "blitzd",
    embed = [":service_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "service_test",
    srcs = ["main_test.go"],
    embed = [":service_lib"],
)
