        "//pkg/engine",
        "//pkg/engine/runtime",
        "//pkg/engine/workers",
        "//pkg/images",
        "//pkg/socket",
        "//proto/blitz/v1:blitzv1_go_proto",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_adk_v2//model",
        "@org_golang_google_genai//:genai",
        "@org_uber_go_goleak//:goleak",
