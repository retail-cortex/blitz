load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "broker.go",
        "convert.go",
        "listen.go",
        "scheduler.go",
        "server.go",
        "session.go",
        "worker.go",
        "workspace.go",
    ],
    importpath = "github.com/retail-cortex/blitz/apps/service/internal/server",
    visibility = ["//apps/service:__subpackages__"],
    deps = [
        "//pkg/api",
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/workers",
        "//pkg/images",
        "//proto/blitz/v1:blitzv1_go_proto",
