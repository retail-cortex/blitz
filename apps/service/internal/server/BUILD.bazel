        "worker_test.go",
    ],
    embed = [":server"],
    deps = [
        "//pkg/api",
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/runtime",
        "//pkg/engine/workers",
        "//pkg/images",
        "//pkg/secrets",
        "//pkg/socket",
        "//proto/blitz/v1:blitzv1_go_proto",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_adk_v2//model",
        "@org_golang_google_genai//:genai",
        "@org_uber_go_goleak//:goleak",
    ],
)
