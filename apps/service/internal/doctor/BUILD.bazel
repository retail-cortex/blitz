load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "doctor",
    srcs = ["doctor.go"],
    importpath = "github.com/retail-cortex/blitz/apps/service/internal/doctor",
    visibility = ["//apps/service:__subpackages__"],
    deps = [
        "//pkg/api",
        "//pkg/config",
        "//pkg/engine",
        "//pkg/engine/browser",
        "//pkg/engine/memory",
        "//pkg/engine/runtime",
        "//pkg/engine/skills",
        "//pkg/engine/tools",
        "//pkg/i18n",
        "//pkg/observability",
        "//pkg/plugins",
        "@org_golang_google_adk_v2//model",
        "@org_golang_google_adk_v2//session",
        "@org_golang_google_genai//:genai",
    ],
)

go_test(
    name = "doctor_test",
    srcs = ["doctor_test.go"],
    embed = [":doctor"],
    deps = [
        "//pkg/config",
        "//pkg/engine",
        "//pkg/plugins",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
