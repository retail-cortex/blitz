+// queryRO runs statement in a read-only transaction when the source is
+// read-only (Blitz), rolled back after: a single statement can't turn the
+// transaction writable and write in it. done closes it, after the rows.
+func queryRO(ctx context.Context, pool *pgxpool.Pool, readOnly bool, statement string, params []any) (pgx.Rows, func(), error) {
+	if !readOnly {
+		rows, err := pool.Query(ctx, statement, params...)
+		return rows, func() {}, err
+	}
+	tx, err := pool.BeginTx(ctx, pgx.TxOptions{AccessMode: pgx.ReadOnly})
+	if err != nil {
+		return nil, func() {}, err
+	}
+	done := func() { _ = tx.Rollback(context.WithoutCancel(ctx)) }
+	rows, err := tx.Query(ctx, statement, params...)
+	if err != nil {
+		done()
+		return nil, func() {}, err
+	}
+	return rows, done, nil
