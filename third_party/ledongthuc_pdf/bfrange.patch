+// codeValue is a character code's big-endian value.
+func codeValue(s string) int {
+	v := 0
+	for i := 0; i < len(s); i++ {
+		v = v<<8 | int(s[i])
+	}
+	return v
+}
+
+// offsetCode adds d to the big-endian number s.
+func offsetCode(s string, d int) string {
+	b := []byte(s)
+	for i := len(b) - 1; i >= 0 && d > 0; i-- {
+		sum := int(b[i]) + d
+		b[i] = byte(sum)
+		d = sum >> 8
+	}
+	return string(b)
 }
 
