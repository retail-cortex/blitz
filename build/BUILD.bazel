# Build rules and settings shared by every package: the Go protos'
# Connect compiler, nogo's static analysis, and the version stamp. The
# rules and macros sit beside this file (es_proto.bzl, macos.bzl,
# pkg_config.bzl); the commands developers run are in //tools.

load("@rules_go//go:def.bzl", "nogo")
load("@rules_go//proto:compiler.bzl", "go_proto_compiler")

# Connect's handlers and clients, in the same package as the messages
# (package_suffix empty), since go_proto_library makes one package.
go_proto_compiler(
    name = "connect_go",
    options = ["package_suffix="],
    plugin = "@com_connectrpc_connect//cmd/protoc-gen-connect-go",
    suffix = ".connect.go",
    valid_archive = False,
    visibility = ["//visibility:public"],
    deps = ["@com_connectrpc_connect//:connect"],
)

# The version, for package metadata: the git tag under --config=release
# (build/workspace_status.sh). Packages need it to start with a digit
# (Debian, CFBundleVersion), so anything else (a commit, "dev") is 0.0.0;
# the binaries still report it.
genrule(
    name = "version",
    outs = ["version.txt"],
    cmd = """
v=dev
[ -f bazel-out/stable-status.txt ] && v="$$(sed -n 's/^STABLE_BLITZ_VERSION //p' bazel-out/stable-status.txt)"
case "$$v" in [0-9]*) ;; *) v=0.0.0 ;; esac
echo "$$v" > $@
""",
    stamp = -1,
    visibility = ["//visibility:public"],
)

# Static analysis in every compile of this repository's Go code: doc
# comments on every package and exported declaration, Go vet's
# analyzers and staticcheck's (its default checks: SA, S and ST but for
# the style checks it leaves off, and SA5011, which only works inside
# staticcheck). Replaces running staticcheck.
