module(name = "blitz")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "bazel_lib", version = "3.7.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# modenv ships BUILD files written for its own workspace; generate ours.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/rrmcguinness/modenv",
)

# Wails picks its native window with build tags; keep those files.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = ["gazelle:build_tags desktop,production,webkit2_41"],
    path = "github.com/wailsapp/wails/v2",
)

# On Linux, Wails's cgo needs GTK and WebKitGTK's flags from pkg-config,
# which rules_go doesn't read from #cgo lines (//bazel:pkg_config.bzl).
go_deps.module_override(
    patch_strip = 1,
    patches = ["//bazel:wails_linux.patch"],
    path = "github.com/wailsapp/wails/v2",
)
use_repo(go_deps, "cc_mvdan_sh_v3", "com_connectrpc_connect", "com_github_anthropics_anthropic_sdk_go", "com_github_aymanbagabas_go_udiff", "com_github_burntsushi_toml", "com_github_charmbracelet_glamour", "com_github_ergochat_readline", "com_github_google_uuid", "com_github_modelcontextprotocol_go_sdk", "com_github_openai_openai_go_v3", "com_github_robfig_cron_v3", "com_github_rrmcguinness_modenv", "com_github_spf13_cobra", "com_github_spf13_pflag", "com_github_wailsapp_wails_v2", "dev_gvisor_gvisor", "in_gopkg_yaml_v3", "io_opentelemetry_go_contrib_bridges_otelslog", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlplog_otlploghttp", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp", "io_opentelemetry_go_otel_log", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_log", "io_opentelemetry_go_otel_trace", "org_golang_google_adk_v2", "org_golang_google_genai", "org_golang_google_protobuf", "org_golang_x_image", "org_golang_x_net", "org_golang_x_sys", "org_golang_x_term", "org_golang_x_text", "org_uber_go_goleak")

pkg_config = use_extension("//bazel:pkg_config.bzl", "pkg_config")
pkg_config.library(
    name = "webkitgtk",
    modules = [
        "gtk+-3.0",
        "gio-unix-2.0",
        "webkit2gtk-4.1",
        "libsoup-3.0",
    ],
)
use_repo(pkg_config, "webkitgtk")

# The desktop page: Node, and its npm packages from pnpm's lockfile.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.16.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = ["//apps/desktop/web:pnpm-workspace.yaml"],
    pnpm_lock = "//apps/desktop/web:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
