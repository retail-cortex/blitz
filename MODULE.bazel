module(name = "blitz")

bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_buf", version = "0.5.4")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Static analysis (vet and staticcheck) on this repository's Go code, not
# its dependencies or the generated protos.
go_sdk.nogo(
    excludes = ["//proto:__subpackages__"],
    includes = ["//:__subpackages__"],
    nogo = "//build:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# modenv ships BUILD files written for its own workspace; generate ours.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/rrmcguinness/modenv",
)

# proto-gen-md-diagrams (the API diagrams on the docs site) ships BUILD
# files for its own workspace too.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/GoogleCloudPlatform/proto-gen-md-diagrams",
)

# Wails picks its native window with build tags; keep those files.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = ["gazelle:build_tags desktop,production,webkit2_41"],
    path = "github.com/wailsapp/wails/v2",
)

# On Linux, Wails's cgo needs GTK and WebKitGTK's flags from pkg-config,
# which rules_go doesn't read from #cgo lines (//build:pkg_config.bzl).
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/wails:linux.patch"],
    path = "github.com/wailsapp/wails/v2",
)

# The PDF reader decodes a ToUnicode range wider than 256 codes wrongly
# (only the last byte is offset), which garbles the text of PDFs written
# with an identity map (fpdf's, TCPDF's).
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/ledongthuc_pdf:bfrange.patch"],
    path = "github.com/ledongthuc/pdf",
)
use_repo(go_deps, "cc_mvdan_sh_v3", "co_honnef_go_tools", "com_connectrpc_connect", "com_github_alecthomas_chroma_v2", "com_github_anthropics_anthropic_sdk_go", "com_github_aws_aws_sdk_go_v2_config", "com_github_aymanbagabas_go_udiff", "com_github_azure_azure_sdk_for_go_sdk_azcore", "com_github_azure_azure_sdk_for_go_sdk_azidentity", "com_github_burntsushi_toml", "com_github_charmbracelet_glamour", "com_github_ergochat_readline", "com_github_go_pdf_fpdf", "com_github_google_addlicense", "com_github_google_jsonschema_go", "com_github_google_uuid", "com_github_googlecloudplatform_proto_gen_md_diagrams", "com_github_gorilla_websocket", "com_github_ledongthuc_pdf", "com_github_modelcontextprotocol_go_sdk", "com_github_openai_openai_go_v3", "com_github_philippgille_chromem_go", "com_github_robfig_cron_v3", "com_github_rrmcguinness_modenv", "com_github_spf13_cobra", "com_github_spf13_pflag", "com_github_stretchr_testify", "com_github_wailsapp_wails_v2", "com_github_yuin_goldmark", "com_google_cloud_go_auth", "com_google_cloud_go_auth_oauth2adapt", "dev_gvisor_gvisor", "in_gopkg_yaml_v3", "io_fyne_systray", "io_opentelemetry_go_contrib_bridges_otelslog", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlplog_otlploghttp", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp", "io_opentelemetry_go_otel_log", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_log", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "org_golang_google_adk_v2", "org_golang_google_genai", "org_golang_google_protobuf", "org_golang_x_image", "org_golang_x_net", "org_golang_x_oauth2", "org_golang_x_sys", "org_golang_x_term", "org_golang_x_text", "org_golang_x_tools", "org_golang_x_vuln", "org_modernc_sqlite", "org_uber_go_goleak")

pkg_config = use_extension("//build:pkg_config.bzl", "pkg_config")
pkg_config.library(
    name = "webkitgtk",
    modules = [
        "gtk+-3.0",
        "gio-unix-2.0",
        "webkit2gtk-4.1",
        "libsoup-3.0",
    ],
)
use_repo(pkg_config, "webkitgtk")

# buf, for the protos' lint and breaking-change checks.
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.73.0")
use_repo(buf, "rules_buf_toolchains")

# The desktop page and the VS Code extension: Node, and their npm packages
# from pnpm's lockfile (one workspace, at the root).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.16.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# pnpm itself, for upkeep of the page's packages without a host pnpm:
#   bazel run -- @pnpm//:pnpm --dir "$PWD/apps/desktop/web" add <package>
#   bazel run -- @pnpm//:pnpm --dir "$PWD" install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.24.0",
)
use_repo(pnpm, "pnpm")

# The documentation site (docs/): Hugo and its Geekdoc theme. rules_hugo
# isn't in the Bazel Central Registry; this is Retail Cortex's fork.
bazel_dep(name = "rules_hugo", version = "0.3.0")
archive_override(
    module_name = "rules_hugo",
    integrity = "sha256-YN2Pwayr5D/3tH2GHKrJL8H4pSPagsAaNhFeW0lJ76Q=",
    strip_prefix = "rules-hugo-0.3.0",
    urls = ["https://github.com/retail-cortex/rules-hugo/archive/refs/tags/v0.3.0.tar.gz"],
)

# rules_hugo's own module registers @hugo (extended Hugo 0.162.0).
hugo_deps = use_extension("@rules_hugo//hugo:extensions.bzl", "hugo_deps")
hugo_deps.http_archive(
    name = "geekdoc",
    build_file_content = """filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["LICENSE", "data/assets.json"])""",
    sha256 = "325d3960e568cb623ee47b498f70ae2da851c6b377b4c6723d5f73dfe24e9d21",
    url = "https://github.com/thegeeklab/hugo-geekdoc/releases/download/v4.1.3/hugo-geekdoc.tar.gz",
)
use_repo(hugo_deps, "geekdoc", "hugo")
